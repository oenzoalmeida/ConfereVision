# Exemplo de variáveis de ambiente. NUNCA coloque valores reais neste arquivo nem o commite com segredos.
# Local (desenvolvimento): basta criar um .env com DEBUG=1 — os demais valores têm padrão seguro.

# 0 = produção (exige SECRET_KEY forte e DATABASE_URL PostgreSQL persistente)
DEBUG=1

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Hostnames separados por vírgula (produção), ex.: conferevision.onrender.com
ALLOWED_HOSTS=

# PostgreSQL persistente em produção, ex.: postgres://usuario:senha@host:5432/conferevision
DATABASE_URL=

# Criação do administrador (comando bootstrap_admin)
ADMIN_USERNAME=administrador
ADMIN_EMAIL=admin@conferevision.invalid
ADMIN_PASSWORD=
